{
  "name": "grandmaster-vs-model",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Sourced world chess championship replay and auditable frontier model predictions",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/ledger.mjs verify",
    "build:data": "node scripts/ledger.mjs build",
    "cache:broadcast": "node scripts/cache-broadcast.mjs --out data/live-game1.json",
    "serve": "python3 -m http.server 8080",
    "capture:once": "node scripts/forecast-cycle.mjs",
    "build:collection": "node scripts/collection.mjs --write",
    "verify:collection": "node scripts/collection.mjs"
  },
  "engines": {
    "node": ">=20"
  },
